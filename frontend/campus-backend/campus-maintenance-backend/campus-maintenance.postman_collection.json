{
  "info": {
    "name": "Campus Maintenance Request Desk",
    "description": "Full API collection for the BIT Campus Maintenance backend. Run 'Login' first - it auto-saves the token to the {{token}} collection variable used by every other request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "complaintId", "value": "1" },
    { "key": "technicianId", "value": "1" },
    { "key": "locationId", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (Student/Staff)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Student\",\n  \"email\": \"student@bitsathy.ac.in\",\n  \"password\": \"password123\",\n  \"role\": \"STUDENT\",\n  \"department\": \"CSE\",\n  \"phone\": \"9999999999\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) { pm.collectionVariables.set('token', body.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@bitsathy.ac.in\",\n  \"password\": \"ChangeThisPassword123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Current User (me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          }
        },
        {
          "name": "Admin: Create User (e.g. a Technician account)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Arun Kumar\",\n  \"email\": \"arun.tech@bitsathy.ac.in\",\n  \"password\": \"password123\",\n  \"role\": \"TECHNICIAN\",\n  \"phone\": \"9876543210\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/admin/create-user", "host": ["{{baseUrl}}"], "path": ["api", "auth", "admin", "create-user"] }
          }
        }
      ]
    },
    {
      "name": "Locations",
      "item": [
        {
          "name": "List Locations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/locations", "host": ["{{baseUrl}}"], "path": ["api", "locations"] }
          }
        }
      ]
    },
    {
      "name": "Complaints",
      "item": [
        {
          "name": "Submit Complaint",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Broken fan", "type": "text" },
                { "key": "description", "value": "Ceiling fan not spinning in C204", "type": "text" },
                { "key": "category", "value": "ELECTRICAL", "type": "text" },
                { "key": "priority", "value": "MEDIUM", "type": "text" },
                { "key": "locationId", "value": "{{locationId}}", "type": "text" },
                { "key": "image", "type": "file", "src": [] }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/complaints", "host": ["{{baseUrl}}"], "path": ["api", "complaints"] }
          }
        },
        {
          "name": "My Complaints",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/complaints/my", "host": ["{{baseUrl}}"], "path": ["api", "complaints", "my"] }
          }
        },
        {
          "name": "All Complaints (admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/complaints?status=OPEN",
              "host": ["{{baseUrl}}"], "path": ["api", "complaints"],
              "query": [{ "key": "status", "value": "OPEN" }]
            }
          }
        },
        {
          "name": "My Tasks (technician)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/complaints/my-tasks", "host": ["{{baseUrl}}"], "path": ["api", "complaints", "my-tasks"] }
          }
        },
        {
          "name": "Complaint Detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/complaints/{{complaintId}}", "host": ["{{baseUrl}}"], "path": ["api", "complaints", "{{complaintId}}"] }
          }
        },
        {
          "name": "Complaint History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/complaints/{{complaintId}}/history", "host": ["{{baseUrl}}"], "path": ["api", "complaints", "{{complaintId}}", "history"] }
          }
        },
        {
          "name": "Update Status (technician)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "status", "value": "IN_PROGRESS", "type": "text" },
                { "key": "remarks", "value": "Started work", "type": "text" },
                { "key": "completionImage", "type": "file", "src": [] }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/complaints/{{complaintId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "complaints", "{{complaintId}}", "status"] }
          }
        },
        {
          "name": "Close Complaint (owner/admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/complaints/{{complaintId}}/close", "host": ["{{baseUrl}}"], "path": ["api", "complaints", "{{complaintId}}", "close"] }
          }
        },
        {
          "name": "Manually Assign Technician (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"technicianId\": {{technicianId}}\n}" },
            "url": { "raw": "{{baseUrl}}/api/complaints/{{complaintId}}/assign", "host": ["{{baseUrl}}"], "path": ["api", "complaints", "{{complaintId}}", "assign"] }
          }
        }
      ]
    },
    {
      "name": "Technicians",
      "item": [
        {
          "name": "List Technicians (admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/technicians", "host": ["{{baseUrl}}"], "path": ["api", "technicians"] }
          }
        },
        {
          "name": "Create Technician Profile (admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": 2,\n  \"specialization\": \"ELECTRICAL\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/technicians", "host": ["{{baseUrl}}"], "path": ["api", "technicians"] }
          }
        },
        {
          "name": "Update Technician (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"availabilityStatus\": \"BUSY\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/technicians/{{technicianId}}", "host": ["{{baseUrl}}"], "path": ["api", "technicians", "{{technicianId}}"] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Search Users (admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/users/search?query=arun&role=TECHNICIAN",
              "host": ["{{baseUrl}}"], "path": ["api", "users", "search"],
              "query": [{ "key": "query", "value": "arun" }, { "key": "role", "value": "TECHNICIAN" }]
            }
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"department\": \"CSE\",\n  \"phone\": \"9998887777\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/users/me", "host": ["{{baseUrl}}"], "path": ["api", "users", "me"] }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Stats (admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/dashboard/stats", "host": ["{{baseUrl}}"], "path": ["api", "dashboard", "stats"] }
          }
        }
      ]
    }
  ]
}
